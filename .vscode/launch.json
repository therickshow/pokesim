{
    // The executable is always pokesim.exe, whichever source file you happen
    // to have open -- the old ${fileBasenameNoExtension} would go looking for
    // build\pokesim_data.exe if you were editing pokesim_data.c.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug PokeSim",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\build\\pokesim.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build PokeSim (debug)"
        },
        {
            "name": "Debug PokeSim self-tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\build\\pokesim.exe",
            "args": [
                "--test"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build PokeSim (debug)"
        }
    ]
}
