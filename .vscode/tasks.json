{
    // ${workspaceFolder}, never ${fileDirname}.
    //
    // ${fileDirname} is the folder of whatever file happens to be open, so
    // pressing Ctrl+Shift+B while looking at launch.json tried to build
    // .vscode\ -- a folder with no .c files in it -- and created an empty
    // .vscode\build\ for its trouble. ${workspaceFolder} is this project, no
    // matter which file has focus, so these work from anywhere.
    //
    // For that to be true, open THIS FOLDER in VS Code (or open
    // Github-projz.code-workspace). Opening the bare "Github projz" folder
    // makes VS Code use the .vscode at the root instead of this one.
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build PokeSim (debug)",
            "command": "${workspaceFolder}/../library/.venv/bin/python.exe",
            "args": [
                "${workspaceFolder}/../library/scripts/build.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "All three sources, warnings on, debug symbols. GTK handled automatically."
        },
        {
            "type": "shell",
            "label": "Build PokeSim (release)",
            "command": "${workspaceFolder}/../library/.venv/bin/python.exe",
            "args": [
                "${workspaceFolder}/../library/scripts/build.py",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Optimised, and no console window. The tournament runs about three times faster."
        },
        {
            "type": "shell",
            "label": "Run PokeSim",
            "command": "${workspaceFolder}/../library/.venv/bin/python.exe",
            "args": [
                "${workspaceFolder}/../library/scripts/build.py",
                "--run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Builds, then opens the window. The simplest way to just run it."
        },
        {
            "type": "shell",
            "label": "Run PokeSim self-tests",
            "command": "${workspaceFolder}/build/pokesim.exe",
            "args": [
                "--test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build PokeSim (debug)",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "57 checks over the data, the loaders and the battle engine."
        },
        {
            "type": "shell",
            "label": "Package PokeSim for distribution",
            "command": "${workspaceFolder}/../library/.venv/bin/python.exe",
            "args": [
                "${workspaceFolder}/../library/scripts/package.py",
                "--zip"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Bundles it with the whole GTK runtime into dist/, and zips it."
        }
    ]
}
